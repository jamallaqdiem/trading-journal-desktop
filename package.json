{
  "name": "trading-journal-desktop",
  "version": "2.0.0",
  "description": "Desktop Trading Journal & Analytics Engine",
  "main": "electron/main.ts",
  "type": "module",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build": "npm run build:react",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "server": "npx tsx server/index.ts"
  },
  "build": {
    "appId": "com.tradingjournal.desktop",
    "productName": "Trading Journal",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "db.sqlite"
    ]
  },
  "dependencies": {
    "axios": "^1.21.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^7.2.0"
  }
}
