{
  "name": "trading-journal-desktop",
  "version": "2.0.0",
  "author": {
    "name": "Jamal Laqdiem",
    "email": "your-email@example.com"
  },
  "description": "Desktop Trading Journal & Analytics Engine",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "build:electron": "esbuild electron/main.ts  electron/preload.js --platform=node --target=node20 --bundle --outdir=dist-electron --format=esm --packages=external",
    "build": "rm -rf dist dist-electron && npm run build:react && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "start": "electron . --no-sandbox --disable-gpu --ozone-platform=x11 --disable-dev-shm-usage",
    "server": "npx tsx server/index.ts"
  },
  "build": {
    "appId": "com.tradingjournal.desktop",
    "productName": "Trading Journal",
    "directories": {
      "output": "release"
    
   },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*",
      "db.sqlite"
    ]
  },
  "dependencies": {
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^2.15.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
